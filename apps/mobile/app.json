{
  "expo": {
    "name": "Medivo Health Intelligence",
    "slug": "medivo-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1F1C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medivo.health",
      "infoPlist": {
        "NSCameraUsageDescription": "Medivo Health requires camera access for real-time AI face match skin analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1F1C"
      },
      "package": "com.medivo.health",
      "permissions": ["CAMERA"]
    }
  }
}
