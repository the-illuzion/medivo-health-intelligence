{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "composite": false,
    "paths": {
      "@medivo/design-system": ["./packages/design-system/src"],
      "@medivo/design-system/*": ["./packages/design-system/src/*"],
      "@medivo/ui": ["./packages/ui/src"],
      "@medivo/ui/*": ["./packages/ui/src/*"],
      "@medivo/theme": ["./packages/theme/src"],
      "@medivo/theme/*": ["./packages/theme/src/*"],
      "@medivo/icons": ["./packages/icons/src"],
      "@medivo/icons/*": ["./packages/icons/src/*"],
      "@medivo/auth": ["./packages/auth/src"],
      "@medivo/auth/*": ["./packages/auth/src/*"],
      "@medivo/api-client": ["./packages/api-client/src"],
      "@medivo/api-client/*": ["./packages/api-client/src/*"],
      "@medivo/ai": ["./packages/ai/src"],
      "@medivo/ai/*": ["./packages/ai/src/*"],
      "@medivo/types": ["./packages/types/src"],
      "@medivo/types/*": ["./packages/types/src/*"],
      "@medivo/utils": ["./packages/utils/src"],
      "@medivo/utils/*": ["./packages/utils/src/*"],
      "@medivo/forms": ["./packages/forms/src"],
      "@medivo/forms/*": ["./packages/forms/src/*"],
      "@medivo/charts": ["./packages/charts/src"],
      "@medivo/charts/*": ["./packages/charts/src/*"],
      "@medivo/analytics": ["./packages/analytics/src"],
      "@medivo/analytics/*": ["./packages/analytics/src/*"],
      "@medivo/notifications": ["./packages/notifications/src"],
      "@medivo/notifications/*": ["./packages/notifications/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}