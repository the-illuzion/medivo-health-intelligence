# ============================================
# Medivo Health Intelligence Platform
# Environment Variables Template
# ============================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medivo
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medivo
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=medivo
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# AI Service
AI_API_KEY=your-ai-api-key
AI_MODEL_ENDPOINT=http://localhost:8080

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@medivo.health

# Push Notifications
FCM_SERVER_KEY=your-fcm-server-key
APNS_KEY_ID=your-apns-key-id

# Payment Gateway
PAYMENT_API_KEY=your-payment-api-key
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Analytics
ANALYTICS_KEY=your-analytics-key

# Feature Flags
FEATURE_SKIN_ANALYSIS=true
FEATURE_HEALTH_REPORTS=true
FEATURE_AI_COACH=true
FEATURE_MARKETPLACE=true
FEATURE_DOCTOR_CONSULTATION=true
