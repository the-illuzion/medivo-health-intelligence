# ============================================================================
# Medivo Health Intelligence Platform — Production Environment Variables
# Host: Oracle Cloud Infrastructure (OCI) Ubuntu / Coolify + Traefik
# ============================================================================

# ============================================================================
# 1. PUBLIC DOMAIN & URL CONFIGURATION (Set your actual production domains)
# ============================================================================
WEB_DOMAIN=example.com
WEB_WWW_DOMAIN=www.example.com
APP_DOMAIN=app.example.com
DOCTOR_DOMAIN=doctor.example.com
ADMIN_DOMAIN=admin.example.com
API_DOMAIN=api.example.com

# Protected Management Tools Domains
DB_ADMIN_DOMAIN=db-admin.example.com
REDIS_ADMIN_DOMAIN=redis-admin.example.com
STORAGE_ADMIN_DOMAIN=storage-admin.example.com

# Public URLs used by Frontends & Apps
NEXT_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_API_URL=https://api.example.com
APP_URL=https://example.com

# Node Environment
NODE_ENV=production

# ============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL 16 Multi-Schema)
# [SECRET] Do NOT expose publicly. Managed on internal Docker network.
# ============================================================================
DATABASE_NAME=medivo
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_with_strong_database_password_32chars_min
DATABASE_PORT=5432
DATABASE_URL=postgresql://postgres:replace_with_strong_database_password_32chars_min@postgres:5432/medivo

# ============================================================================
# 3. CACHE & QUEUE CONFIGURATION (Redis 7)
# [SECRET] Managed on internal Docker network.
# ============================================================================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ============================================================================
# 4. SECURITY & AUTHENTICATION SECRETS
# [SECRET] Critical cryptographic keys. Rotate periodically.
# ============================================================================
JWT_SECRET=replace_with_cryptographically_secure_random_jwt_secret_64chars_min
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# 5. OBJECT STORAGE (MinIO / AWS S3 AI Scan Vault)
# [SECRET] Encrypted at rest.
# ============================================================================
S3_ENDPOINT=http://minio:9000
S3_BUCKET=medivo
S3_REGION=us-east-1
S3_ACCESS_KEY=replace_with_secure_minio_access_key
S3_SECRET_KEY=replace_with_secure_minio_secret_key_32chars_min

# ============================================================================
# 6. INTERNAL MICROSERVICE URLS (For Customer BFF)
# ============================================================================
AI_SERVICE_URL=http://service-ai:8080
AUTH_SERVICE_URL=http://service-auth:4001
APPOINTMENTS_SERVICE_URL=http://service-appointments:4002
COMMERCE_SERVICE_URL=http://service-commerce:4003
NOTIFICATIONS_SERVICE_URL=http://service-notifications:4004

# ============================================================================
# 7. AI VISION ENGINE CONFIGURATION
# [SECRET] Optional provider credentials (Falls back to AUTO/SIMULATED if unset)
# ============================================================================
AI_PROVIDER_DEFAULT=AUTO
MODEL_VERSION=v2.4-onnx-resnet50
PERFECT_CORP_API_KEY=
PERFECT_CORP_SECRET_KEY=
PERFECT_CORP_ENDPOINT=https://api.perfectcorp.com/v1/skin/analyze
SHEN_API_KEY=
SHEN_CLIENT_SECRET=
SHEN_ENDPOINT=https://api.shen.ai/v1/health/scan

# ============================================================================
# 8. NOTIFICATION & EMAIL (SMTP)
# ============================================================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@medivo.health
FCM_SERVER_KEY=
APNS_KEY_ID=

# ============================================================================
# 9. COMMERCE & PAYMENTS GATEWAY
# [SECRET] Stripe / Payment provider credentials
# ============================================================================
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ============================================================================
# 10. FEATURE FLAGS
# ============================================================================
FEATURE_SKIN_ANALYSIS=true
FEATURE_HEALTH_REPORTS=true
FEATURE_AI_COACH=true
FEATURE_MARKETPLACE=true
FEATURE_DOCTOR_CONSULTATION=true
